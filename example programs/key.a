class duck{
    private string name
    private int favoriteNumber

    function Duck(){
        name = "Jeff"
        favoriteNumber = 3
    }

    function .add(x){
        favoriteNumber++
        favoriteNumber = int((favoriteNumber + x) / x)
        return favoriteNumber
    }

    function .print(){
        print("Favorite Number: " + favoriteNumber)
    }
}

duck one = Duck()

