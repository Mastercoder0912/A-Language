{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "A Language",
    "scopeName": "source.a",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#fstrings"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.a",
                    "begin": "#",
                    "end": "$"
                },
                {
                    "name": "comment.line.double-slash.a",
                    "begin": "//",
                    "end": "$"
                },
                {
                    "name": "comment.block.a",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "fstrings": {
            "patterns": [
                {
                    "name": "string.quoted.double.interpolated.a",
                    "begin": "\\bf\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.a"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.a"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.a",
                            "match": "\\\\."
                        },
                        {
                            "name": "meta.interpolation.a",
                            "begin": "\\{",
                            "beginCaptures": {
                                "0": {
                                    "name": "punctuation.section.interpolation.begin.a"
                                }
                            },
                            "end": "\\}",
                            "endCaptures": {
                                "0": {
                                    "name": "punctuation.section.interpolation.end.a"
                                }
                            },
                            "patterns": [
                                {
                                    "include": "#numbers"
                                },
                                {
                                    "include": "#constants"
                                },
                                {
                                    "include": "#operators"
                                },
                                {
                                    "include": "#functions"
                                },
                                {
                                    "include": "#variables"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.a",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.a"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.a"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.a",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.a",
                    "begin": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.a"
                        }
                    },
                    "end": "'",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.a"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.a",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.a",
                    "match": "\\b0[xX][0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.float.a",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.a",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "name": "meta.import.a",
                    "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
                    "captures": {
                        "1": {
                            "name": "keyword.control.import.a"
                        },
                        "2": {
                            "name": "support.module.a"
                        },
                        "3": {
                            "name": "keyword.control.import.as.a"
                        },
                        "4": {
                            "name": "variable.other.alias.a"
                        }
                    }
                },
                {
                    "name": "meta.function.declaration.a",
                    "begin": "\\b(function)\\s+(\\.)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.function.a"
                        },
                        "2": {
                            "name": "punctuation.accessor.a"
                        },
                        "3": {
                            "name": "entity.name.function.a"
                        }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.parameters.end.a"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#numbers"
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "include": "#constants"
                        },
                        {
                            "include": "#operators"
                        },
                        {
                            "name": "variable.parameter.a",
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                        }
                    ]
                },
                {
                    "name": "meta.type.declaration.a",
                    "match": "\\b(class|struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.a"
                        },
                        "2": {
                            "name": "entity.name.type.a"
                        }
                    }
                },
                {
                    "name": "meta.variable.declaration.a",
                    "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.a"
                        },
                        "2": {
                            "name": "variable.other.constant.a"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.a",
                    "match": "\\b(if|else|loop|return|pass)\\b"
                },
                {
                    "name": "keyword.declaration.a",
                    "match": "\\b(function|class|struct|import|as)\\b"
                },
                {
                    "name": "storage.modifier.a",
                    "match": "\\b(const|private|public)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.a",
                    "match": "\\b(int|char|string|boolean|bool|float|list|dict|void)\\b"
                },
                {
                    "name": "support.type.a",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.a",
                    "match": "\\b(True|False|true|false)\\b"
                },
                {
                    "name": "constant.language.null.a",
                    "match": "\\b(null|None|nil)\\b"
                },
                {
                    "name": "support.function.builtin.a",
                    "match": "\\b(print|len|type|input|randint|int|string|bool|boolean|float|char)\\b(?=\\s*\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.logical.a",
                    "match": "\\b(and|or)\\b"
                },
                {
                    "name": "keyword.operator.compound.a",
                    "match": "(\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|&&|\\|\\||->|::|<<|>>)"
                },
                {
                    "name": "keyword.operator.assignment.a",
                    "match": "="
                },
                {
                    "name": "keyword.operator.comparison.a",
                    "match": "[<>!]"
                },
                {
                    "name": "keyword.operator.arithmetic.a",
                    "match": "[+\\-*/%]"
                },
                {
                    "name": "keyword.operator.member.a",
                    "match": "\\."
                },
                {
                    "name": "keyword.operator.pointer.a",
                    "match": "\\*"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "meta.method-call.a",
                    "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.a"
                        },
                        "2": {
                            "name": "entity.name.function.member.a"
                        }
                    }
                },
                {
                    "name": "meta.function-call.a",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.a"
                        }
                    }
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.member.a",
                    "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.a"
                        },
                        "2": {
                            "name": "variable.other.member.a"
                        }
                    }
                },
                {
                    "name": "variable.other.a",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        }
    }
}
