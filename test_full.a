print("test: null data type")
print("expected: null")
print("current: " + string(null))

print("test: int data type")
print("expected: 42")
int test_int = 42
print("current: " + string(test_int))

print("test: byte data type")
print("expected: 255")
byte test_byte = byte(255)
print("current: " + string(test_byte))

print("test: string data type")
print("expected: hello")
string test_string = "hello"
print("current: " + test_string)

print("test: bool True data type")
print("expected: True")
bool test_bool_true = True
print("current: " + string(test_bool_true))

print("test: bool False data type")
print("expected: False")
bool test_bool_false = False
print("current: " + string(test_bool_false))

print("test: char data type")
print("expected: a")
char test_char = 'a'
print("current: " + string(test_char))

print("test: list data type")
print("expected: [1, 2, 3]")
list test_list = [1, 2, 3]
print("current: " + string(test_list))

print("test: dict data type")
print("expected: dict with one = 1 and two = 2")
dict test_dict = {
    "one": 1,
    "two": 2
}
print("current: dict with one = " + string(test_dict["one"]) + " and two = " + string(test_dict["two"]))

print("test: type() null")
print("expected: null")
print("current: " + type(null))

print("test: type() int")
print("expected: int")
print("current: " + type(test_int))

print("test: type() byte")
print("expected: byte")
print("current: " + type(test_byte))

print("test: type() string")
print("expected: string")
print("current: " + type(test_string))

print("test: type() bool")
print("expected: bool")
print("current: " + type(test_bool_true))

print("test: type() list")
print("expected: list")
print("current: " + type(test_list))

print("test: type() dict")
print("expected: dict")
print("current: " + type(test_dict))

print("test: int() from string")
print("expected: 123")
print("current: " + string(int("123")))

print("test: int() from bool")
print("expected: 1")
print("current: " + string(int(True)))

print("test: int() from byte")
print("expected: 255")
print("current: " + string(int(test_byte)))

print("test: byte() from int")
print("expected: 44")
print("current: " + string(byte(300)))

print("test: byte() from string")
print("expected: 12")
print("current: " + string(byte("12")))

print("test: byte() from bool")
print("expected: 1")
print("current: " + string(byte(True)))

print("test: string() from int")
print("expected: 987")
print("current: " + string(987))

print("test: list() from string")
print("expected: [a, b, c]")
print("current: " + string(list("abc")))

print("test: list() from dict")
print("expected: [one, two]")
print("current: " + string(list(test_dict)))

print("test: len() string")
print("expected: 5")
print("current: " + string(len("hello")))

print("test: len() list")
print("expected: 3")
print("current: " + string(len(test_list)))

print("test: len() dict")
print("expected: 2")
print("current: " + string(len(test_dict)))

print("test: pow()")
print("expected: 81")
print("current: " + string(pow(3, 4)))

print("test: pow() returns 9")
print("expected: 9")
print("current: " + string(pow(3, 2)))

print("test: randint() fixed range")
print("expected: 5")
print("current: " + string(randint(5, 5)))

print("test: write_file() and read_file()")
print("expected: file text")
write_file("test_full_output.txt", "file text")
print("current: " + read_file("test_full_output.txt"))

print("test: arithmetic addition")
print("expected: 13")
print("current: " + string(10 + 3))

print("test: arithmetic subtraction")
print("expected: 7")
print("current: " + string(10 - 3))

print("test: arithmetic multiplication")
print("expected: 30")
print("current: " + string(10 * 3))

print("test: arithmetic division")
print("expected: 3")
print("current: " + string(10 / 3))

print("test: arithmetic modulo")
print("expected: 1")
print("current: " + string(10 % 3))

print("test: comparison ==")
print("expected: True")
print("current: " + string(10 == 10))

print("test: comparison !=")
print("expected: True")
print("current: " + string(10 != 9))

print("test: comparison >")
print("expected: True")
print("current: " + string(10 > 9))

print("test: comparison <")
print("expected: True")
print("current: " + string(9 < 10))

print("test: comparison >=")
print("expected: True")
print("current: " + string(10 >= 10))

print("test: comparison <=")
print("expected: True")
print("current: " + string(9 <= 10))

print("test: logical &&")
print("expected: False")
print("current: " + string(True && False))

print("test: logical ||")
print("expected: True")
print("current: " + string(False || True))

print("test: logical and")
print("expected: False")
print("current: " + string(True and False))

print("test: logical or")
print("expected: True")
print("current: " + string(False or True))

print("test: string concatenation")
print("expected: Hello World")
print("current: " + ("Hello" + " World"))

print("test: f-string")
print("expected: value is 42")
print(f"current: value is {test_int}")

print("test: if else")
print("expected: pass branch")
if test_int == 42 {
    print("current: pass branch")
}
else {
    print("current: fail branch")
}

print("test: counted loop")
print("expected: 3")
int loop_total = 0
loop(3 as i) {
    loop_total = loop_total + 1
}
print("current: " + string(loop_total))

function add(a, b) {
    return a + b
}

print("test: function add()")
print("expected: 7")
print("current: " + string(add(3, 4)))

function greet(name, ending="!") {
    return "Hello, " + name + ending
}

print("test: function default parameter")
print("expected: Hello, Ada!")
print("current: " + greet("Ada"))

print("test: list index read")
print("expected: 2")
print("current: " + string(test_list[1]))

print("test: list index write")
print("expected: [1, 9, 3]")
test_list[1] = 9
print("current: " + string(test_list))

print("test: .fill()")
print("expected: [7, 7, 7]")
test_list.fill(7)
print("current: " + string(test_list))

print("test: .append()")
print("expected: [7, 7, 7, 8]")
test_list.append(8)
print("current: " + string(test_list))

print("test: .remove()")
print("expected: [7, 7, 8]")
test_list.remove(7)
print("current: " + string(test_list))

print("test: .reverse()")
print("expected: [8, 7, 7]")
test_list.reverse()
print("current: " + string(test_list))

print("test: .sort()")
print("expected: [7, 7, 8]")
test_list.sort()
print("current: " + string(test_list))

print("test: list .index() found")
print("expected: 0")
print("current: " + string(test_list.index(7)))

print("test: list .index() missing")
print("expected: -1")
print("current: " + string(test_list.index(99)))

string method_text = "Hello Hello"

print("test: .upper()")
print("expected: HELLO HELLO")
print("current: " + method_text.upper())

print("test: .lower()")
print("expected: hello hello")
print("current: " + method_text.lower())

print("test: .find()")
print("expected: 3")
print("current: " + string(method_text.find("lo")))

print("test: string .index()")
print("expected: 0")
print("current: " + string(method_text.index("He")))

print("test: .substring()")
print("expected: Hello")
print("current: " + method_text.substring(0, 5))

print("test: .replace()")
print("expected: Hi Hi")
print("current: " + method_text.replace("Hello", "Hi"))

print("test: .substringCount()")
print("expected: 2")
print("current: " + string(method_text.substringCount("Hello")))

print("test: .split()")
print("expected: [Hello, Hello]")
print("current: " + string(method_text.split(" ")))

print("test: .join()")
print("expected: red-blue-green")
print("current: " + "-".join(["red", "blue", "green"]))

print("test: dict index read")
print("expected: 1")
print("current: " + string(test_dict["one"]))

print("test: dict index write")
print("expected: 3")
test_dict["three"] = 3
print("current: " + string(test_dict["three"]))

print("test: .get()")
print("expected: 2")
print("current: " + string(test_dict.get("two")))

print("test: .keys()")
print("expected: [one, two, three]")
print("current: " + string(test_dict.keys()))

print("test: .values()")
print("expected: [1, 2, 3]")
print("current: " + string(test_dict.values()))

print("test: .items()")
print("expected: [[one, 1], [two, 2], [three, 3]]")
print("current: " + string(test_dict.items()))

print("test: .update()")
print("expected: 4")
test_dict.update({"four": 4})
print("current: " + string(test_dict.get("four")))

struct Point {
    int x;
    int y;
}

Point p = Point(3, 7)

print("test: struct field x")
print("expected: 3")
print("current: " + string(p.x))

print("test: struct field y")
print("expected: 7")
print("current: " + string(p.y))

class Dog {
    private string name

    function Dog() {
        name = "Buddy"
    }

    function .getName() {
        return name
    }
}

Dog dog = Dog()

print("test: class method")
print("expected: Buddy")
print("current: " + dog.getName())

print("test: pass statement")
print("expected: after pass")
pass
print("current: after pass")

print("test: comments")
print("expected: comments work")
print("current: comments work")

print("test: logical not")
print("expected: False")
print("current: " + string(!True))

print("test: lowercase true literal")
print("expected: True")
bool lowercase_true = true
print("current: " + string(lowercase_true))

print("test: += assignment")
print("expected: 7")
int plus_eq_value = 5
plus_eq_value += 2
print("current: " + string(plus_eq_value))

print("test: -= assignment")
print("expected: 5")
plus_eq_value -= 2
print("current: " + string(plus_eq_value))

print("test: ++ increment")
print("expected: 6")
plus_eq_value++
print("current: " + string(plus_eq_value))

print("test: -- decrement")
print("expected: 5")
plus_eq_value--
print("current: " + string(plus_eq_value))

print("test: cast syntax int")
