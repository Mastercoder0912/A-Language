# 9. COUNTED LOOP (100%)
# ------------------------------------------------------------
print("--- 9. COUNTED LOOP ---")

# prints 0 1 2 3 4 (fails)
loop(5 as i) {
    print(i)
}

# accumulator via counted loop
int total = 0
loop(6 as k) {
    total = total + k
}
print(total)    # 0+1+2+3+4+5 = 15 (fails)


