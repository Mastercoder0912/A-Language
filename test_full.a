# ------------------------------------------------------------
# 26. CLASS METHODS
# ------------------------------------------------------------
print("--- 26. CLASS METHODS ---")

class Dog {
    private string name

    function Dog() {
        name = "Buddy"
    }

    function .getName() {
        return name
    }
}

Dog dog = Dog()
print(dog.getName())        # Buddy


# ------------------------------------------------------------
# 27. COLLECTION MUTATION
# ------------------------------------------------------------
print("--- 27. COLLECTION MUTATION ---")

list mutable = [1, 2, 3]
mutable[1] = 9
print(mutable)              # [1, 9, 3]

mutable.fill(7)
print(mutable)              # [7, 7, 7]

dict mutable_dict = {
    "a": 1
}

mutable_dict["b"] = 2
print(mutable_dict["b"])    # 2

