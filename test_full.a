# ------------------------------------------------------------
# 21. FUNCTION WITH LOOP INSIDE 
# ------------------------------------------------------------
print("--- 21. FUNCTION WITH LOOP ---")

function sum_to(n) {
    int acc = 0
    loop(n as i) {
        acc = acc + i
    }
    return acc
}

print(sum_to(5))    # 10  (0+1+2+3+4)
print(sum_to(10))   # 45


