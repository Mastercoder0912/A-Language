# ------------------------------------------------------------
# 1. BASIC TYPES & PRINT: 100% pass
# ------------------------------------------------------------
print("--- 1. BASIC TYPES ---")

int    a = 42
string b = "hello"
bool   c = True
bool   d = False
int    n = null

print(a)        # 42
print(b)        # hello
print(c)        # True
print(d)        # False
print(n)        # null


# ------------------------------------------------------------
# 2. ARITHMETIC: 100% pass
# ------------------------------------------------------------
print("--- 2. ARITHMETIC ---")

int x = 10
int y = 3

print(x + y)    # 13
print(x - y)    # 7
print(x * y)    # 30
print(x / y)    # 3  (integer division)
print(x % y)    # 1


# ------------------------------------------------------------
# 3. COMPARISONS: 100% pass
# ------------------------------------------------------------
print("--- 3. COMPARISONS ---")

print(10 == 10)     # True
print(10 == 9)      # False
print(10 != 9)      # True
print(10 > 9)       # True
print(10 < 9)       # False
print(10 >= 10)     # True
print(10 <= 9)      # False


# ------------------------------------------------------------
# 4. LOGICAL OPERATORS: 100% pass
# ------------------------------------------------------------
print("--- 4. LOGICAL ---")

print(True && True)    # True
print(True && False)   # False
print(False || True)    # True
print(False || False)   # False


# ------------------------------------------------------------
# 5. STRING CONCATENATION: 100%
# ------------------------------------------------------------
print("--- 5. STRINGS ---")

string first = "Hello"
string second = " World"
string combined = first + second
print(combined)                     # Hello World
print("Length: " + string(len(combined)))   # Length: 11


# ------------------------------------------------------------
# 6. CASTING: 100%
# ------------------------------------------------------------
print("--- 6. CASTING ---")

int   from_str  = int("99")
string from_int = string(123)
int   from_bool = int(True)

print(from_str)     # 99
print(from_int)     # 123
print(from_bool)    # 1


# ------------------------------------------------------------
# 7. F-STRINGS: 100%
# ------------------------------------------------------------
print("--- 7. F-STRINGS ---")

int age = 25
string name = "Alex"
print(f"Name: {name}, Age: {age}")              # Name: Alex, Age: 25
print(f"10 + 5 = {10 + 5}")                     # 10 + 5 = 15
print(f"type of age: {type(age)}")              # type of age: int


# ------------------------------------------------------------
# 8. IF / ELSE IF / ELSE: 33% pass
# ------------------------------------------------------------
print("--- 8. IF/ELSE ---")

int score = 75

if score >= 90 {
    print("A")
}
else if score >= 80 {
    print("B")
}
else if score >= 70 {
    print("C")       # should print
}
else {
    print("F")
}

if True && True {
    print("both true")      # both true (fails)
}

if False || True {
    print("at least one")   # at least one (fails)
}

if True {
    pass
}
else {
    print("should not print")
}


