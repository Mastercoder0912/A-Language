# 12. BUILTIN FUNCTIONS (100%)
# ------------------------------------------------------------
print("--- 12. BUILTINS ---")

print(type(42))             # int
print(type("hi"))           # string
print(type(True))           # bool
print(type(null))           # null
print(type([1,2]))          # list
print(type({"a": 1}))      # dict

print(len("hello"))         # 5
print(len([1,2,3]))         # 3

print(string(999))          # 999
print(int("77"))            # 77


# ------------------------------------------------------------
# 13. FUNCTIONS — BASIC (100%)
# ------------------------------------------------------------
print("--- 13. FUNCTIONS ---")

function greet(name) {
    return "Hello, " + name + "!"
}

print(greet("World"))       # Hello, World!
print(greet("Alex"))        # Hello, Alex!

function square(n) {
    return n * n
}

print(square(5))    # 25
print(square(12))   # 144


# ------------------------------------------------------------
# 14. FUNCTIONS — MULTIPLE PARAMS & EXPRESSIONS (50% pass)
# ------------------------------------------------------------
print("--- 14. MULTI-PARAM FUNCTIONS ---")

function add(a, b) {
    return a + b
}

function multiply(a, b) {
    return a * b
}

function power(base, exp) {
    int result = 1
    loop(exp as i) {
        result = result * base
    }
    return result
}

print(add(3, 4))            # 7
print(multiply(6, 7))       # 42
print(power(2, 8))          # 256 (fails)
print(power(3, 4))          # 81 (fails)


# ------------------------------------------------------------
# 15. FUNCTIONS — RETURN INSIDE LOOP (0%)
# ------------------------------------------------------------
print("--- 15. RETURN IN LOOP ---")

function find_first_even(limit) {
    loop(limit as i) {
        if i % 2 == 0 {
            if i > 0 {
                return i
            }
        }
    }
    return -1
}

print(find_first_even(10))   # 2


# ------------------------------------------------------------
# 16. FUNCTIONS — CALLING OTHER FUNCTIONS (100%)
# ------------------------------------------------------------
print("--- 16. FUNCTION COMPOSITION ---")

function double(n) {
    return n * 2
}

function double_then_add(a, b) {
    return double(a) + double(b)
}

print(double_then_add(3, 4))    # 14
print(double(double(5)))         # 20


# ------------------------------------------------------------
# 17. RECURSIVE FUNCTION (100%)
# ------------------------------------------------------------
print("--- 17. RECURSION ---")

function factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

print(factorial(1))     # 1
print(factorial(5))     # 120
print(factorial(10))    # 3628800

function fib(n) {
    if n <= 0 {
        return 0
    }
    if n == 1 {
        return 1
    }
    return fib(n - 1) + fib(n - 2)
}

print(fib(0))   # 0
print(fib(1))   # 1
print(fib(7))   # 13
print(fib(10))  # 55


