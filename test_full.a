struct Node{
    int id;
    string data;
    boolean endOfLinkedList;
}

Node nodeA = Node(1, "first", False)

print(nodeA)


# ------------------------------------------------------------
# 12. Pointers
# ------------------------------------------------------------

print("TEST 12: Pointers")

Node* nodePointer = nodeA
Node copiedNode = *nodePointer

print(copiedNode)


# ------------------------------------------------------------
# 13. Classes
# ------------------------------------------------------------

print("TEST 13: Classes")

class Counter{
    private int value

    function Counter(){
        value = 0
    }

    function .add(x){
        value = value + x
        return value
    }

    function .get(){
        return value
    }
}

Counter counter = Counter()

print(counter.add(10))
print(counter.add(5))
print(counter.get())


