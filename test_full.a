}

print("test: conditional loop")
print("expected: 3")
int conditional_count = 0
loop(conditional_count < 3) {
    conditional_count += 1
}
print("current: " + string(conditional_count))

print("test: single-line loop with colon")
print("expected: 2")
int line_loop_count = 0
loop(line_loop_count < 2): line_loop_count += 1
print("current: " + string(line_loop_count))

print("test: queue fifo remove order")
print("expected: first")
q = queue_create(0)
queue_add(q, "first", 0)
queue_add(q, "second", 0)
print("current: " + string(queue_remove(q)))

print("test: queue priority peek")
print("expected: high")
pq = queue_create(1)
queue_add(pq, "low", 1)
queue_add(pq, "high", 9)
print("current: " + string(queue_peek(pq)))

print("test: queue is empty")
print("expected: False")
print("current: " + string(queue_is_empty(pq)))

print("test: json dumps")
print("expected: True")
print("current: " + string(len(json.dumps({"only": 1})) > 0))

print("test: json loads")
print("expected: 3")
dict loaded_json = json.loads(json.dumps({"n": 3}))
print("current: " + string(loaded_json.get("n")))

print("test: json dump/load file")
print("expected: 8")
json.dump("tmp_json_test.json", {"k": 8})
dict loaded_from_file = json.load("tmp_json_test.json")
print("current: " + string(loaded_from_file.get("k")))

