print(nums)             # [10, 20, 30, 40, 50]
print(nums[0])          # 10
print(nums[4])          # 50
print(len(nums))        # 5

list empty = []
print(empty)            # []

list mixed = [1, "two", True]
print(mixed)            # [1, two, True]


# ------------------------------------------------------------
# 11. DICTS (100%)
# ------------------------------------------------------------
print("--- 11. DICTS ---")

dict person = {
    "name": "Jordan",
    "age": 30,
    "active": True
}

print(person)               # {name: Jordan, age: 30, active: True}
print(person["name"])       # Jordan
print(person["age"])        # 30
print(len(person))          # 3


