# ------------------------------------------------------------
# 23. Class + arithmetic + functions
# ------------------------------------------------------------

print("TEST 23: Class interaction")

class Calculator{
    private int value

    function Calculator(start){
        value = start
    }

    function .add(x){
        value = value + x
        return value
    }

    function .square(){
        value = pow(value, 2)
        return value
    }
}

Calculator calc = Calculator(5)

calc.add(3)

print(calc.square())


# ------------------------------------------------------------
# 24. Complex conditional logic
# ------------------------------------------------------------

print("TEST 24: Complex conditionals")

function classify(x){
    if x > 30{
        return "greater than 30"
    }
    else if x > 20{
        return "21-30"
    }
    else if x > 10{
        return "11-20"
    }
    else{
        return "10 or less"
    }
}

print(classify(35))
print(classify(25))
print(classify(15))
print(classify(5))


# ------------------------------------------------------------
# 25. Final integration
# ------------------------------------------------------------

print("TEST 25: Final integration")

function calculate(x, y){
    int result = pow(x + y, 2)
    return result
}

list results = []

loop (5 as i){
    results.append(calculate(i, 2))
}

print(results)

string finalText = "v1.1.0"

print(f"{finalText} integration test complete!")


