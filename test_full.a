print(testString)
print(testBool)
print(testNull)


# ------------------------------------------------------------
# 2. Arithmetic
# ------------------------------------------------------------

print("TEST 2: Arithmetic")

int a = 10
int b = 3

print(a + b)
print(a - b)
print(a * b)
print(a / b)
print(a % b)

# Exponentiation uses pow()
print(pow(4, 2))
print(pow(2, 10))


# ------------------------------------------------------------
# 3. Boolean logic
# ------------------------------------------------------------

print("TEST 3: Boolean logic")

if True{
    print("TRUE PASS")
}

if False{
    print("FALSE FAIL")
}
else{
    print("FALSE PASS")
}

if True and True{
    print("AND PASS")
}

if True or False{
    print("OR PASS")
}


# ------------------------------------------------------------
# 4. Casting and type
# ------------------------------------------------------------

print("TEST 4: Casting")

int convertedInt = int("123")
string convertedString = string(456)

print(convertedInt)
print(convertedString)

print(type(convertedInt))
print(type(convertedString))


# ------------------------------------------------------------
# 5. Lists
# ------------------------------------------------------------

print("TEST 5: Lists")

list numbers = []

numbers.append(10)
numbers.append(20)
numbers.append(30)

print(numbers)
print(len(numbers))

numbers.reverse()
print(numbers)

numbers.sort()
print(numbers)

print(numbers.index(20))

numbers.remove(20)

print(numbers)


# ------------------------------------------------------------
# 6. Dictionaries
# ------------------------------------------------------------

print("TEST 6: Dictionaries")

dict person = {
    "name": "Jeff",
    "age": 20
}

print(person.get("name"))
print(person.get("age"))

print(person.keys())
print(person.values())
print(person.items())

person.update({
    "age": 21
})

print(person.get("age"))


# ------------------------------------------------------------
# 7. Strings
# ------------------------------------------------------------

print("TEST 7: Strings")

string text = "Hello World"

print(text.upper())
print(text.lower())
print(text.find("World"))
print(text.substring(0, 5))
print(text.replace("World", "a"))
print(text.substringCount("l"))
print(text.split(" "))


# ------------------------------------------------------------
# 8. Functions
# ------------------------------------------------------------

print("TEST 8: Functions")

function add(x, y){
    return x + y
}

function multiply(x, y){
    return x * y
}

print(add(5, 7))
print(multiply(6, 8))


# ------------------------------------------------------------
# 9. Recursive functions
# ------------------------------------------------------------

print("TEST 9: Recursion")

function factorial(n){
    if n <= 1{
        return 1
    }

    return n * factorial(n - 1)
}

print(factorial(6))


# ------------------------------------------------------------
# 10. Loops
# ------------------------------------------------------------

print("TEST 10: Loops")

loop (5 as i){
    print(i)
}


# ------------------------------------------------------------
# 11. Structs
