#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
    echo "No Git repository was found from the current folder."
    exit 1
fi

remote_url="$(git -C "$repo_root" remote get-url origin 2>/dev/null || true)"
if [[ -z "$remote_url" ]]; then
    echo "No 'origin' remote was found for this repository."
    exit 1
fi

current_path="$(pwd)"
rel_path="${current_path#$repo_root/}"
if [[ "$rel_path" == "$current_path" ]]; then
    rel_path="(repo root)"
fi

echo "Git repository: $repo_root"
echo "Current folder: $rel_path"
echo "Remote: $remote_url"

echo
read -r -p "Do you want to save this folder? [y/N] " response
case "$response" in
    [Yy]|[Yy][Ee][Ss])
        commit_message="saved on $(date +%Y-%m-%d)"
        echo "Running git add ."
        git -C "$repo_root" add .
        echo "Running git commit -m '$commit_message'"
        git -C "$repo_root" commit -m "$commit_message"
        echo "Running git push"
        git -C "$repo_root" push
        ;;
    *)
        echo "Save canceled."
        ;;
esac
